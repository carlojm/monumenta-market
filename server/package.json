{
  "name": "server",
  "version": "0.0.1",
  "description": "monumenta market directory",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build:ui": "rm -rf dist && cd ../client && npm run build && cp -r dist ../server/",
    "deploy": "fly deploy",
    "deploy:full": "npm run build:ui && npm run deploy",
    "db:load": "node db/load_plots.js",
    "tags:load": "node db/load_tags.js",
    "plots": "node scripts/plots.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "author": "carlo",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "minecraft-protocol": "^1.68.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10"
  }
}
